Set Shell bash
Set FontFamily "JetBrains Mono"
Set FontSize 18
Set Width 1600
Set Height 780
Set Padding 24
Set Theme { "background": "#0f0f0f", "foreground": "#e4e4e4", "cursor": "#e4e4e4", "black": "#1a1a1a", "red": "#f87171", "green": "#4ade80", "yellow": "#facc15", "blue": "#60a5fa", "magenta": "#c084fc", "cyan": "#22d3ee", "white": "#e4e4e4", "brightBlack": "#6b6b6b", "brightRed": "#fca5a5", "brightGreen": "#86efac", "brightYellow": "#fde047", "brightBlue": "#93c5fd", "brightMagenta": "#d8b4fe", "brightCyan": "#67e8f9", "brightWhite": "#ffffff" }
Set WindowBar Colorful
Set WindowBarSize 44

Type "node bin/skaff.js"
Enter
Sleep 2s
Type "my-website"
Enter
Sleep 500ms
Enter
Sleep 500ms
Enter
Sleep 500ms
Enter
Sleep 1s
Screenshot demo/skaff.png
